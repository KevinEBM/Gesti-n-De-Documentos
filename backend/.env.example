# Ejemplo de variables de entorno para el backend.
# Spring Boot NO carga este archivo automaticamente.
# Exportar estas variables al entorno del proceso (shell, systemd, panel del servidor)
# antes de ejecutar: java -jar gestion-documental-*.jar

DB_URL=jdbc:postgresql://localhost:5432/gestion_documental
DB_USERNAME=postgres
DB_PASSWORD=change_me

# Secreto JWT: cadena Base64 valida que decodifique a >= 32 bytes (HS256).
JWT_SECRET=replace_with_secure_base64_secret
JWT_EXPIRATION_MS=3600000

# Desarrollo local (opcional; application.properties tiene defaults)
CORS_ALLOWED_ORIGINS=http://localhost:5173
STORAGE_LOCATION=uploads
STORAGE_MAX_FILE_SIZE=10485760
MAX_UPLOAD_FILE_SIZE=10MB
MAX_UPLOAD_REQUEST_SIZE=11MB

LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# Zona horaria del proceso. En produccion DEBE ser UTC.
# El modulo documental ya usa Clock/UTC; catalogos, usuarios y ApiResponse
# todavia usan LocalDateTime.now() naive. Fijar TZ evita la zona del host.
# PostgreSQL y Flyway V1-V11 no requieren cambios por esto.
TZ=UTC

# Alternativa si el entorno no permite TZ:
# JAVA_TOOL_OPTIONS=-Duser.timezone=UTC

# Produccion (ejemplo conceptual; valores reales se definiran en A7):
# SPRING_PROFILES_ACTIVE=prod
# CORS_ALLOWED_ORIGINS=https://documentos.example.com
# STORAGE_LOCATION=/var/lib/gestion-documental/uploads
