# Copiar a .env.production (ese archivo esta en .gitignore; no commitearlo).
# Uso: docker compose --env-file .env.production up -d
# Spring Boot no carga este archivo solo; Compose lo inyecta al contenedor backend.

# --- PostgreSQL (servicio db del compose) ---
# El host DEBE ser "db" (nombre del servicio), no localhost.
# El nombre de base DEBE ser gestion_documental (POSTGRES_DB en docker-compose.yml).
DB_URL=jdbc:postgresql://db:5432/gestion_documental
DB_USERNAME=postgres
DB_PASSWORD=change_me

# --- JWT ---
# Cadena Base64 valida que decodifique a >= 32 bytes (HS256).
# Generar con: openssl rand -base64 32
JWT_SECRET=replace_with_secure_base64_secret
JWT_EXPIRATION_MS=3600000

# --- Produccion ---
# Origen(es) del frontend servido por Nginx (sin *; HTTPS del dominio real).
# Reemplazar documentos.example.com por el dominio definitivo antes del despliegue.
CORS_ALLOWED_ORIGINS=https://documentos.example.com

# Debe coincidir exactamente con el destino del volumen backend_uploads
# en docker-compose.yml. Si se cambia aqui, hay que cambiar el compose.
STORAGE_LOCATION=/var/lib/gestion-documental/uploads

TZ=UTC
PORT=8080

STORAGE_MAX_FILE_SIZE=10485760
MAX_UPLOAD_FILE_SIZE=10MB
MAX_UPLOAD_REQUEST_SIZE=11MB

LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

PASSWORD_CHANGE_RATE_LIMIT_MAX_ATTEMPTS=5
PASSWORD_CHANGE_RATE_LIMIT_WINDOW_SECONDS=3600
